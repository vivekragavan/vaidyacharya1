---
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import content from '../../data/content.json';
import bio from '../../data/biography.json';
import { slug, hamsaPdf } from '../../lib/site';
import { link } from '../../lib/url';

const { home } = content;
const { bibliography } = bio;

// The four Works tabs, each filled from groups of the Biography page's bibliography.
const tabs = [
  {
    label: 'Ayurveda Medicine',
    groups: ['Ayurveda – Medicine'],
    // In the order of the landing page's Know More section, ahead of the rest.
    first: ['Astanga Hridaya', 'Madhava Nidhana'],
    // After all the rest.
    last: ['Jīvānandanam'],
    // Text only: its book pictures are on the Pictures page.
    noImages: true,
  },
  // Text only: its book pictures are on the Pictures page.
  { label: 'Vedanta Philosophy', groups: ['Vedanta – Philosophy'], noImages: true },
  {
    label: 'Language and Literature',
    groups: ['Language and Literature'],
    // In the order of the landing page's Know More section, ahead of the rest.
    first: ['Kirat Arjuniya'],
    // Text only: its book pictures are on the Pictures page.
    noImages: true,
  },
  { label: 'General', groups: ['Keynote Address', 'Available online'] },
];

// Books with a picture and description on this page, keyed by how their
// bibliography entry's title begins. Each is used for the first match only.
const cards: Record<string, string> = {
  'Astanga Hridaya': 'Ashtanga Hridayam',
  'Jīvānandanam': 'Jivanandanam of Anandaraya Makhin',
  'Madhava Nidhana': 'Madhava Nidanam',
  'Kirat Arjuniya': 'Kiratarjuniya',
  'The Presidential Address': 'The Presidential Address',
  'Tantra Sara Sangraha': 'Tantrasarasangra Pandit',
};
const used = new Set<string>();
const titleOf = (text: string) => text.match(/<cite>(.*?)<\/cite>/)?.[1] ?? text.replace(/<[^>]+>/g, '');
const entry = (it: { text: string; note?: string }) => {
  const title = titleOf(it.text);
  const key = Object.keys(cards).find((k) => title.startsWith(k) && !used.has(k));
  if (key) used.add(key);
  const book = key ? home.books.find((b) => b.title === cards[key]) : undefined;
  return {
    title,
    citation: it.text,
    image: book?.image,
    id: book ? slug(book.title) : undefined,
    description: [...(book?.description ?? []), ...(it.note ? [it.note] : [])],
  };
};
// Bibliography entries shown under a different tab from their bibliography group,
// keyed by how their title begins.
const moved: Record<string, string> = {
  'Mēkasantēcam': 'Language and Literature',
  'Tantra Sara Sangraha': 'Vedanta Philosophy',
};
const all = bibliography.groups.flatMap((g) =>
  g.items.map((it) => {
    const e = entry(it);
    const to = Object.keys(moved).find((k) => e.title.startsWith(k));
    return { ...e, tab: to ? moved[to] : tabs.find((t) => t.groups.includes(g.heading))?.label };
  }),
);
const rank = (t: (typeof tabs)[number], title: string) => {
  if (('last' in t ? t.last : []).some((k) => title.startsWith(k))) return 2;
  const i = ('first' in t ? t.first : []).findIndex((k) => title.startsWith(k));
  return i < 0 ? 1 : i / 100;
};
const panels = tabs.map((t) => ({
  entries: all
    .filter((e) => e.tab === t.label)
    .sort((a, b) => rank(t, a.title) - rank(t, b.title))
    .map((e) => ('noImages' in t ? { ...e, image: undefined } : e)),
  footnotes: bibliography.groups
    .filter((g) => t.groups.includes(g.heading))
    .flatMap((g) => ('footnote' in g && g.footnote ? [g.footnote] : [])),
}));

// Books on this page that no bibliography entry picked up keep their old listing.
const placed = new Set([...used].map((k) => cards[k]));
const rest = home.books.filter((b) => !placed.has(b.title));
const groups = [...new Set(rest.map((b) => b.category))];
---

<Base title="Books" description="The books of Pandit Duraiswami Aiyangar: Ayurveda, Sanskrit literature and general books, with the Hamsa Sandesham English translation to read and download.">
  <section class="page-head wrap head">
    <h1 class="eyebrow">Books of Pandit Duraiswami Aiyangar</h1>
  </section>

  <section class="wrap">
    <div class="tabs" role="tablist" aria-label="Categories of works">
      {tabs.map((t, i) => (
        <button type="button" role="tab" id={`tab-${i}`} aria-controls={`panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{t.label}</button>
      ))}
    </div>
    {tabs.map((t, i) => (
      <div class="panel" role="tabpanel" id={`panel-${i}`} aria-labelledby={`tab-${i}`} tabindex="0">
        {t.label === 'Vedanta Philosophy' && (
          <WorkCard title="Hamsa Sandesham (English Translation)" id="hamsa-sandesham" headingLevel="h3" description={[]}>
            <p class="tp">{hamsaPdf.titlePage.map((l) => <span>{l}</span>)}</p>
            <p>English translation by {hamsaPdf.translator}. PDF, {hamsaPdf.pages} pages, {hamsaPdf.size}.</p>
            <div class="actions">
              <a class="btn solid" href={link('/works/hamsa-sandesham/')}>Read online</a>
              <a class="btn" href={link(hamsaPdf.href)} download>Download PDF</a>
            </div>
          </WorkCard>
        )}
        {panels[i].entries.map((e) => (
          <WorkCard title={e.title} image={e.image} description={e.description} id={e.id}>
            <p class="citation" set:html={e.citation} />
          </WorkCard>
        ))}
        {panels[i].footnotes.map((f) => <p class="footnote">{f}</p>)}
      </div>
    ))}

    {groups.map((g) => (
      <>
        <h2 class="group">{g}</h2>
        {rest.filter((b) => b.category === g).map((b) => (
          <WorkCard title={b.title} image={b.image} description={b.description} id={slug(b.title)} />
        ))}
      </>
    ))}
  </section>
</Base>

<script>
  for (const list of document.querySelectorAll<HTMLElement>('[role="tablist"]')) {
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
      }
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const step = { ArrowRight: 1, ArrowLeft: -1 }[e.key];
        if (!step) return;
        const next = tabs[(i + step + tabs.length) % tabs.length];
        select(next);
        next.focus();
      });
    });
    select(tabs.find((t) => t.getAttribute('aria-selected') === 'true') ?? tabs[0]);
  }
</script>

<style>
  /* The page title is the small line above the tabs, with no gap before them. */
  .head {
    padding-bottom: 0;
  }
  .head h1 {
    font-family: inherit;
    font-weight: inherit;
    letter-spacing: 0.14em;
  }
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    border-bottom: 1px solid var(--line);
  }
  .tabs [role='tab'] {
    font: inherit;
    font-size: var(--step--1);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    background: none;
    border: 0;
    border-bottom: 3px solid transparent;
    padding: 12px 16px;
    margin-bottom: -1px;
    cursor: pointer;
  }
  .tabs [role='tab']:hover {
    color: var(--accent);
  }
  .tabs [role='tab'][aria-selected='true'] {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .citation {
    font-size: var(--step--1);
    color: var(--muted);
    padding-top: 12px;
    border-top: 1px dotted var(--line);
  }
  .footnote {
    padding-block: 24px;
    border-top: 1px solid var(--line);
    font-style: italic;
  }
  .tp span {
    display: block;
  }
  .tp span:first-child {
    font-family: var(--font-display);
    font-size: var(--step-1);
    letter-spacing: 0.06em;
  }
  .group {
    margin-top: clamp(40px, 6vw, 72px);
    font-size: var(--step--1);
    font-family: var(--font-body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
</style>
